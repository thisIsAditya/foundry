{
  "name": "@foundry/cdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "synth": "cdk synth --quiet",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@foundry/config": "workspace:*",
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.7.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "aws-cdk": "2.1136.0",
    "eslint": "9.39.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
