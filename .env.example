NODE_ENV=development

# Local Docker Compose (plan/11 I1). Do not point these at AWS RDS for day-to-day work.
DATABASE_URL=postgres://foundry:foundry@localhost:5432/foundry
TEST_DATABASE_URL=postgres://foundry:foundry@localhost:5432/foundry_test

# Local Docker Compose default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Public origin of apps/web (Better Auth base URL)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-characters

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AWS_REGION=ap-south-1
AWS_S3_UPLOADS_BUCKET=foundry-uploads
AWS_S3_ARTIFACTS_BUCKET=
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=foundry
AWS_SECRET_ACCESS_KEY=foundryfoundry

# Optional local ClamAV (docker compose --profile clamav up -d)
CLAMD_HOST=
CLAMD_PORT=3310

# Local Mailpit default: localhost:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

FOUNDRY_SECRETS_KEY=replace-with-64-hex-chars-or-at-least-32-chars

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Test-only: allow 127.0.0.1 MCP fixture servers
ALLOW_MCP_LOOPBACK=
