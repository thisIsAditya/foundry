NODE_ENV=development

# Local Docker Compose (plan/11 I1). Do not point these at AWS RDS for day-to-day work.
DATABASE_URL=postgres://foundry:foundry@localhost:5432/foundry
TEST_DATABASE_URL=postgres://foundry:foundry@localhost:5432/foundry_test

# Local Docker Compose default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Public origin of apps/web (Better Auth base URL)
BETTER_AUTH_URL=http://localhost:3210
BETTER_AUTH_SECRET=replace-with-at-least-32-characters

# Expo app (apps/mobile) — same origin the tRPC/Better Auth server listens on
EXPO_PUBLIC_API_BASE_URL=http://localhost:3210

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AWS_REGION=ap-south-1
AWS_S3_UPLOADS_BUCKET=foundry-uploads
AWS_S3_ARTIFACTS_BUCKET=
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=
AWS_S3_ACCESS_KEY_ID=foundry
AWS_S3_SECRET_ACCESS_KEY=foundryfoundry
BEDROCK_AUTO_CONNECT=true
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5

# Local DeepSeek Harness sidecar. Set mode to harness to prevent fallback to
# the deterministic direct runtime when the sidecar is unavailable.
FOUNDRY_AI=harness
FOUNDRY_HARNESS_URL=http://localhost:8787
FOUNDRY_HARNESS_TOKEN=local-dev-harness-token-change-before-deploy-2026
FOUNDRY_CAPABILITY_INVOKE_URL=http://host.docker.internal:3210/api/internal/capabilities/invoke
# Max model output tokens per harness turn. Long artifacts (surveys, interview
# guides) need headroom above the SDK default (1800) or the JSON response gets
# truncated mid-generation. Raise further if artifacts still get cut off.
DSH_MAX_OUTPUT_TOKENS=4000

# Optional local ClamAV (docker compose --profile clamav up -d)
CLAMD_HOST=
CLAMD_PORT=3310

# Local Mailpit default: localhost:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

FOUNDRY_SECRETS_KEY=replace-with-64-hex-chars-or-at-least-32-chars

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Optional: enables the co-founder's evidence.searchWeb@1 capability (Exa search API).
# Without it, the co-founder reports web search as unavailable rather than inventing results.
EXA_API_KEY=

# Optional local Ollama (OpenAI-compatible). Bedrock is the default model path.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:e4b

# Test-only: allow 127.0.0.1 MCP fixture servers
ALLOW_MCP_LOOPBACK=
