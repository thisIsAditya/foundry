{
  "name": "@foundry/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@foundry/domain": "workspace:*",
    "node-pg-migrate": "7.9.1",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@foundry/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
